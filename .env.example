# Shared PostgreSQL database (same instance the public site uses)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Must be identical to the value used by the public site
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Public URL of THIS admin app (no trailing slash)
NEXTAUTH_URL=http://localhost:3001

# Optional: enables ticket status e-mails. Without it, e-mails are skipped.
RESEND_API_KEY=

# Verified sender in Resend, e.g. "Bakyson <tickets@yourdomain.com>".
# Defaults to Resend's test sender, which only delivers to your own account email.
RESEND_FROM=
