# Shared PostgreSQL database (same instance the public site uses)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Must be identical to the value used by the public site
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Public URL of THIS admin app (no trailing slash)
NEXTAUTH_URL=http://localhost:3001

# Optional: enables the /api/diagnose troubleshooting endpoint.
# Unset it (or delete app/api/diagnose) once sign-in works.
DIAG_TOKEN=

# Required for password reset e-mails. Optional for ticket status e-mails.
RESEND_API_KEY=

# Verified sender in Resend, e.g. "Bakyson <tickets@yourdomain.com>".
# Required for password reset links; the default test sender only delivers to
# the Resend account owner's address.
RESEND_FROM=
